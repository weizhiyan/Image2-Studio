# 服务监听配置：局域网共享给同事时保持 SERVER_HOST=0.0.0.0。
# 端口可以改；如果端口被占用，例如改为 8888。
SERVER_HOST=0.0.0.0
PORT=8787

# 对外访问地址：本机预览用 127.0.0.1；局域网共享时改成你的电脑局域网 IP。
# 示例：PUBLIC_BASE_URL=http://192.168.1.23:8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# OpenAI official or compatible relay endpoint.
# 图像生成模型配置：用于真正生成图片。
# 官方 OpenAI：IMAGE_PROVIDER_BASE=https://api.openai.com/v1
# 中转站：把 BASE 改成中转站给你的 /v1 地址，把 KEY 改成中转站 Key。
# MODEL 填你的图像模型名，例如 gpt-image-2 / gpt-image-1 / 中转站自定义模型名。
IMAGE_PROVIDER_BASE=https://your-relay.example/v1
IMAGE_PROVIDER_API_KEY=sk-your-image-key
IMAGE_PROVIDER_MODEL=gpt-image-2
IMAGE_PROVIDER_NAME=openai-compatible

# Optional generation defaults.
IMAGE_DEFAULT_SIZE=1024x1024
IMAGE_DEFAULT_QUALITY=high
IMAGE_REQUEST_TIMEOUT_MS=180000

# 语言模型 / 小 Agent 配置：用于优化中文提示词，不直接生成图片。
# 推荐填写 LANGUAGE_MODEL_BASE / LANGUAGE_MODEL_API_KEY / LANGUAGE_MODEL_NAME 三件套。
# 留空 LANGUAGE_MODEL_BASE 或 KEY 时，系统会使用 backend/mini-agent.js 的本地 skills 小 Agent。
LANGUAGE_MODEL_BASE=https://api.deepseek.com
LANGUAGE_MODEL_API_KEY=sk-your-language-key
LANGUAGE_MODEL_NAME=deepseek-v4-flash
LANGUAGE_REQUEST_TIMEOUT_MS=18000

# 可选：兼容旧版外部 Agent 接口。只有你有自定义 Agent 服务时才填写。
AGENT_ENDPOINT=
AGENT_API_KEY=
